# Copy to .env and fill in. .env is git-ignored; never commit a key.

# Directory containing counts.csv and metadata.csv (defaults to ./candidate_data).
# BIOINFO_DATA_DIR=candidate_data

# Backend choice (--backend auto|openai|compatible|offline). With "auto":
#   1. LLM_BASE_URL set      -> OpenAI-compatible server, local or hosted (Ollama, llamafile, ...)
#   2. OPENAI_API_KEY set    -> OpenAI
#   3. neither               -> offline keyword mode (no LLM, no network)

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Reasoning effort (low, medium, high) with summaries shown; "off" for non-reasoning models.
OPENAI_REASONING=low

# Local or any OpenAI-compatible server. Examples:
#   Ollama:    LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3:4b
#   llamafile: LLM_BASE_URL=http://localhost:8080/v1    (model name is ignored)
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
